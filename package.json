{
  "name": "@fuww/progressive-img",
  "version": "1.0.0",
  "description": "Custom element to load img progressively and lazily. It first shows tiny blurred placeholder and loads full-sized image afterwards. It can also load image after click or entering viewport",
  "keywords": [
    "progressive",
    "lazy",
    "image",
    "img",
    "web component",
    "custom element",
    "element",
    "html"
  ],
  "main": "dist/progressive-img.js",
  "repository": "https://github.com/fuww/progressive-img.git",
  "author": "FashionUnited",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@babel/preset-env": "7.18.10",
    "babel-loader": "8.2.5",
    "core-js": "3.24.1",
    "eslint": "8.22.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.26.0",
    "html-loader": "4.1.0",
    "http-server": "14.1.1",
    "terser-webpack-plugin": "5.3.5",
    "webpack": "5.74.0",
    "webpack-cli": "4.10.0"
  },
  "scripts": {
    "build": "webpack --mode=production",
    "start": "npm run build && http-server -a localhost",
    "lint": "eslint --cache ."
  }
}
